HYDRADB_API_KEY=
HYDRADB_DATABASE=palimpsest

# Custom OpenAI-compatible endpoint (litellm openai/ provider pointed at a proxy).
LLM_API_KEY=
LLM_API_BASE=https://v2.pincc.ai/v1
PALIMPSEST_LLM_TIMEOUT_SECONDS=60

PALIMPSEST_CHEAP_MODEL=gpt-5.4-mini
PALIMPSEST_STRONG_MODEL=gpt-5.5
PALIMPSEST_INGEST_CONCURRENCY=5
# HydraDB request/queue backpressure controls.
PALIMPSEST_HYDRA_REQUEST_TIMEOUT_SECONDS=30
PALIMPSEST_HYDRA_BATCH_SIZE=8
PALIMPSEST_HYDRA_BATCH_TIMEOUT_SECONDS=20
PALIMPSEST_HYDRA_QUEUE_RETRIES=2
PALIMPSEST_HYDRA_QUEUE_RETRY_BACKOFF_SECONDS=3
PALIMPSEST_MAX_SPEND_USD=45
